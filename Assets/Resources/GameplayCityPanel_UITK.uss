.gameplay-city-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: stretch;
    justify-content: flex-end;
}

.gameplay-city-panel {
    width: 100%;
    min-height: 220px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 14px;
    padding-left: 28px;
    background-color: rgba(0, 0, 0, 0.62);
    border-top-width: 2px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-color: rgba(255, 255, 255, 0.42);
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    row-gap: 12px;
}

.gameplay-city-header-row {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    column-gap: 18px;
    min-height: 84px;
}

.gameplay-city-info-column {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    row-gap: 2px;
    min-width: 0;
}

.gameplay-city-name {
    color: rgb(255, 255, 255);
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    flex-shrink: 1;
    min-width: 0;
    height: 50px;
    white-space: nowrap;
    overflow: hidden;
}

.gameplay-city-owner {
    color: rgba(255, 255, 255, 0.88);
    font-size: 30px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    min-height: 32px;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
}

.gameplay-city-recruit-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 156px;
    width: 100%;
}

.gameplay-city-recruit-button {
    min-width: 300px;
    width: 300px;
    height: 156px;
    color: rgb(255, 255, 255);
    font-size: 44px;
    background-color: rgba(0, 0, 0, 0.62);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.52);
    border-right-color: rgba(255, 255, 255, 0.52);
    border-bottom-color: rgba(255, 255, 255, 0.52);
    border-left-color: rgba(255, 255, 255, 0.52);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
    overflow: hidden;
}

.gameplay-city-close-button {
    width: 92px;
    height: 72px;
    color: rgb(255, 255, 255);
    font-size: 34px;
    background-color: rgba(0, 0, 0, 0.62);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.52);
    border-right-color: rgba(255, 255, 255, 0.52);
    border-bottom-color: rgba(255, 255, 255, 0.52);
    border-left-color: rgba(255, 255, 255, 0.52);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 0;
    margin-right: 0;
}
