.gameplay-city-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: stretch;
    justify-content: flex-end;
}

.gameplay-city-panel {
    width: 100%;
    min-height: 180px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 14px;
    padding-left: 28px;
    background-color: rgba(0, 0, 0, 0.62);
    border-top-width: 2px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-color: rgba(255, 255, 255, 0.42);
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    row-gap: 8px;
}

.gameplay-city-recruit-row {
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    flex-grow: 1;
    min-height: 140px;
    width: 100%;
    padding-top: 6px;
    padding-bottom: 6px;
}

.gameplay-city-recruit-button {
    min-width: 240px;
    width: 100%;
    max-width: 360px;
    min-height: 88px;
    flex-grow: 1;
    align-self: stretch;
    color: rgb(255, 255, 255);
    font-size: 30px;
    background-color: rgba(0, 0, 0, 0.62);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.52);
    border-right-color: rgba(255, 255, 255, 0.52);
    border-bottom-color: rgba(255, 255, 255, 0.52);
    border-left-color: rgba(255, 255, 255, 0.52);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
    overflow: hidden;
}
