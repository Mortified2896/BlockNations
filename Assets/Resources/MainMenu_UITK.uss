.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(52, 74, 118);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.panel {
    width: 96%;
    max-width: 780px;
    max-height: 100%;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
}

#MainPanel {
    max-width: 620px;
    min-height: 68%;
    justify-content: center;
    padding-top: 116px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

#MainPanel .title {
    font-size: 74px;
    margin-bottom: 42px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

#MainPanel .menu-button {
    height: 84px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(15, 17, 21);
    background-color: rgb(247, 248, 250);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(25, 29, 36, 0.2);
    border-right-color: rgba(25, 29, 36, 0.2);
    border-bottom-color: rgba(25, 29, 36, 0.28);
    border-left-color: rgba(25, 29, 36, 0.2);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MainPanel #PlayVsAIButton {
    margin-top: 28px;
    height: 90px;
    background-color: rgb(240, 242, 246);
}

#MultiplayerPanel {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 18px;
    bottom: 18px;
    flex-direction: column;
    justify-content: flex-start;
    padding-left: 0;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.title {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.subtitle {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
    margin-bottom: 10px;
    -unity-text-align: middle-left;
}

.menu-button {
    height: 72px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 26px;
    color: rgb(45, 49, 57);
    background-color: rgb(237, 238, 241);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.small {
    flex-grow: 1;
    max-width: 240px;
    margin-left: 5px;
    margin-right: 5px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
    margin-bottom: 8px;
}

.list-heading {
    margin-top: 0;
    margin-bottom: 8px;
    font-size: 18px;
    color: rgb(234, 241, 252);
}

.games-list {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(230, 239, 255, 0.55);
    border-right-color: rgba(230, 239, 255, 0.55);
    border-bottom-color: rgba(230, 239, 255, 0.55);
    border-left-color: rgba(230, 239, 255, 0.55);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 10px;
}

.game-card {
    min-height: 92px;
    margin-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    align-items: flex-start;
    justify-content: center;
    background-color: rgb(22, 124, 176);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(0, 0, 0, 0.12);
    border-left-color: rgba(255, 255, 255, 0.2);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.game-card-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(243, 250, 255);
    -unity-text-align: middle-left;
}

.game-card-status {
    margin-top: 4px;
    font-size: 22px;
    color: rgba(243, 250, 255, 0.78);
    -unity-text-align: middle-left;
}

.details-panel {
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(230, 239, 255, 0.45);
}

.details-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

.details-subtitle {
    margin-top: 4px;
    margin-bottom: 8px;
    color: rgb(227, 236, 250);
}

.danger {
    color: rgb(255, 167, 167);
}

.status {
    margin-top: 8px;
    margin-bottom: 8px;
    min-height: 20px;
    color: rgb(232, 240, 252);
    font-size: 14px;
}

.action-bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 12px;
    padding-bottom: 12px;
}

.action-bar .small {
    margin-left: 8px;
    margin-right: 8px;
}

.version-label {
    position: absolute;
    top: 16px;
    right: 16px;

    font-size: 35px;
    color: rgba(255, 255, 255, 0.7);

    -unity-text-align: upper-right;
}

.non-mvp-hidden {
    display: none;
}
