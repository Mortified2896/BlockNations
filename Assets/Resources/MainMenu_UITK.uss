    padding-right: 18px;
    padding-top: 10px;
    padding-bottom: 10px;
    align-self: flex-end;
    color: rgb(238, 242, 250);
    font-size: 22px;
    background-color: rgba(35, 49, 85, 0.88);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-text-align: middle-center;
}

#ProfilePanel .profile-back-button {
    width: 100%;
    height: 76px;
    margin-top: auto;
    color: rgb(232, 237, 247);
    background-color: rgba(70, 94, 152, 0.82);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 3px;
    border-left-width: 2px;
    border-top-color: rgba(173, 190, 233, 0.52);
    border-right-color: rgba(131, 154, 212, 0.38);
    border-bottom-color: rgba(27, 44, 85, 0.64);
    border-left-color: rgba(131, 154, 212, 0.38);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-font-style: bold;
}

#ProfilePanel .profile-back-button .unity-button__text,
#ProfilePanel .profile-back-button .unity-text-element {
    color: rgb(232, 237, 247);
    font-size: 28px;
    -unity-font-style: bold;
}

.title {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.menu-button {
    height: 72px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 26px;
    color: rgb(45, 49, 57);
    background-color: rgb(237, 238, 241);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.small {
    flex-grow: 1;
    max-width: 240px;
    margin-left: 5px;
    margin-right: 5px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
    margin-bottom: 8px;
}

.details-panel {
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(230, 239, 255, 0.45);
}

.details-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

.details-subtitle {
    margin-top: 4px;
    margin-bottom: 8px;
    color: rgb(227, 236, 250);
}

.danger {
    color: rgb(255, 167, 167);
}

.status {
    margin-top: 8px;
    margin-bottom: 8px;
    min-height: 20px;
    color: rgb(232, 240, 252);
    font-size: 14px;
}

.version-label {
    position: absolute;
    top: 16px;
    right: 16px;

    font-size: 35px;
    color: rgba(255, 255, 255, 0.7);

    -unity-text-align: upper-right;
}

