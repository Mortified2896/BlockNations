.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(49, 77, 121);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.panel {
    width: 96%;
    max-width: 780px;
    max-height: 100%;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
}

#MainPanel {
    max-width: 620px;
    min-height: 68%;
    justify-content: center;
    padding-top: 116px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

#MainPanel .title {
    font-size: 74px;
    margin-bottom: 42px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

#MainPanel .menu-button {
    height: 84px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(15, 17, 21);
    background-color: rgb(247, 248, 250);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(25, 29, 36, 0.2);
    border-right-color: rgba(25, 29, 36, 0.2);
    border-bottom-color: rgba(25, 29, 36, 0.28);
    border-left-color: rgba(25, 29, 36, 0.2);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MainPanel #MultiplayerButton {
    position: relative;
}

#MainPanel .multiplayer-button-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 16px;
    height: 16px;
    background-color: rgb(218, 56, 43);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

#MainPanel #PlayVsAIButton {
    margin-top: 28px;
    height: 90px;
    background-color: rgb(240, 242, 246);
}

#MultiplayerPanel {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 18px;
    bottom: 18px;
    flex-direction: column;
    justify-content: flex-start;
    padding-left: 0;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

#MultiplayerPanel.multiplayer-pane {
    padding-top: 10px;
    padding-bottom: 6px;
}

#MultiplayerPanel .multiplayer-header-row {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
    margin-bottom: 26px;
}

#MultiplayerPanel .multiplayer-refresh-countdown {
    align-self: center;
    margin-top: 6px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.96);
    -unity-text-align: middle-center;
}

#MultiplayerPanel .multiplayer-version-label {
    display: none;
    position: absolute;
    top: 10px;
    right: 0;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.72);
    -unity-text-align: middle-right;
}

#MultiplayerPanel .multiplayer-games-list {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    margin-top: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-bottom: 10px;
}

#MultiplayerPanel .multiplayer-games-list .unity-scroll-view__content-viewport,
#MultiplayerPanel .multiplayer-games-list .unity-scroll-view__viewport {
    flex-grow: 1;
    min-height: 0;
}

#MultiplayerPanel .multiplayer-games-list .unity-scroll-view__content-container {
    flex-grow: 1;
    min-height: 0;
    padding-bottom: 0;
    align-items: stretch;
    justify-content: flex-start;
}

#MultiplayerPanel .multiplayer-game-card {
    flex-grow: 0;
    min-height: 156px;
    max-height: 168px;
    margin-bottom: 14px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
    align-items: flex-start;
    align-self: stretch;
    justify-content: flex-start;
    background-color: rgb(22, 124, 176);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(0, 0, 0, 0.12);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MultiplayerPanel .multiplayer-game-card.multiplayer-game-card--last {
    margin-bottom: 0;
}

#MultiplayerPanel .multiplayer-games-section-header {
    margin-top: 6px;
    margin-bottom: 12px;
    padding-top: 6px;
    padding-left: 24px;
    border-top-width: 1px;
    border-top-color: rgba(232, 240, 252, 0.14);
    color: rgba(232, 240, 252, 0.82);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

#MultiplayerPanel .multiplayer-games-list.multiplayer-games-list--single .multiplayer-game-card.multiplayer-game-card--single {
    min-height: 172px;
    max-height: 180px;
}

#MultiplayerPanel .multiplayer-game-card-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(243, 250, 255);
    -unity-text-align: middle-left;
}

#MultiplayerPanel .multiplayer-game-card-status {
    margin-top: 8px;
    font-size: 24px;
    color: rgba(243, 250, 255, 0.78);
    -unity-text-align: middle-left;
}

#MultiplayerPanel .multiplayer-game-card.multiplayer-game-card--waiting {
    background-color: rgba(145, 170, 214, 0.38);
    border-top-color: rgba(255, 255, 255, 0.26);
    border-right-color: rgba(255, 255, 255, 0.26);
    border-bottom-color: rgba(0, 0, 0, 0.12);
    border-left-color: rgba(255, 255, 255, 0.26);
}

#MultiplayerPanel .multiplayer-game-card-title.multiplayer-game-card-title--waiting {
    color: rgba(243, 250, 255, 0.97);
}

#MultiplayerPanel .multiplayer-game-card-status.multiplayer-game-card-status--waiting {
    color: rgba(243, 250, 255, 0.76);
}

#MultiplayerPanel .multiplayer-empty-state {
    flex-grow: 1;
    align-self: stretch;
    margin-top: 8px;
    color: rgba(232, 240, 252, 0.92);
    font-size: 22px;
    -unity-text-align: upper-left;
}

#MultiplayerPanel .multiplayer-details-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 42px;
    bottom: 92px;
    justify-content: center;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(0, 0, 0, 0);
}

#MultiplayerPanel .multiplayer-details-card {
    width: 100%;
    max-width: 820px;
    min-height: 440px;
    flex-direction: column;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 24px;
    background-color: rgba(72, 92, 142, 0.98);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(0, 0, 0, 0.18);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MultiplayerPanel .multiplayer-details-content,
#MultiplayerPanel .multiplayer-details-confirm-content {
    width: 100%;
    min-height: 100%;
    height: 100%;
    flex-direction: column;
    flex-grow: 1;
}

#MultiplayerPanel .multiplayer-details-confirm-content {
    justify-content: flex-start;
}

#MultiplayerPanel .multiplayer-details-header {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

#MultiplayerPanel .multiplayer-details-title {
    flex-grow: 1;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

#MultiplayerPanel .multiplayer-details-subtitle {
    margin-top: 10px;
    margin-bottom: 8px;
    color: rgb(227, 236, 250);
    font-size: 30px;
    white-space: normal;
}

#MultiplayerPanel .multiplayer-details-gameid {
    margin-bottom: 22px;
    color: rgba(227, 236, 250, 0.78);
    font-size: 21px;
    white-space: normal;
}

#MultiplayerPanel .multiplayer-details-actions {
    flex-direction: row;
    justify-content: space-between;
}

#MultiplayerPanel .multiplayer-details-actions-bottom {
    width: 100%;
    margin-top: auto;
}

#MultiplayerPanel .multiplayer-details-actions-secondary {
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

#MultiplayerPanel .multiplayer-details-button {
    flex-grow: 1;
    max-width: none;
    height: 74px;
    margin-left: 8px;
    margin-right: 8px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

#MultiplayerPanel .multiplayer-details-button .unity-button__text,
#MultiplayerPanel .multiplayer-details-button .unity-text-element {
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

#MultiplayerPanel .multiplayer-details-button-secondary {
    flex-grow: 0;
    width: 260px;
    max-width: 100%;
    font-size: 24px;
    color: rgb(38, 43, 52);
    background-color: rgb(226, 230, 238);
}

#MultiplayerPanel .multiplayer-details-button-secondary .unity-button__text,
#MultiplayerPanel .multiplayer-details-button-secondary .unity-text-element {
    color: rgb(38, 43, 52);
}

#MultiplayerPanel .multiplayer-details-button-danger {
    color: rgb(230, 52, 52);
}

#MultiplayerPanel .multiplayer-details-button-danger .unity-button__text,
#MultiplayerPanel .multiplayer-details-button-danger .unity-text-element {
    color: rgb(230, 52, 52);
    -unity-font-style: bold;
}

#MultiplayerPanel .multiplayer-details-button-danger-corner {
    flex-grow: 0;
    width: 188px;
    min-width: 188px;
    margin-top: 0;
    margin-right: 0;
}

#MultiplayerPanel .multiplayer-confirm-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

#MultiplayerPanel .multiplayer-confirm-body {
    color: rgb(227, 236, 250);
    font-size: 28px;
    white-space: normal;
}

#MultiplayerPanel .multiplayer-confirm-body-region {
    flex-grow: 1;
    justify-content: center;
    padding-top: 14px;
    padding-bottom: 14px;
}

#MultiplayerPanel .multiplayer-confirm-actions {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
}

#MultiplayerPanel .multiplayer-status {
    flex-grow: 1;
    min-width: 0;
    min-height: 34px;
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(232, 240, 252);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

#MultiplayerPanel .multiplayer-join-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 42px;
    bottom: 92px;
    justify-content: center;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(0, 0, 0, 0);
}

#MultiplayerPanel .multiplayer-join-card {
    width: 100%;
    max-width: 820px;
    min-height: 360px;
    flex-direction: column;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 24px;
    background-color: rgba(72, 92, 142, 0.98);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(0, 0, 0, 0.18);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MultiplayerPanel .multiplayer-join-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

#MultiplayerPanel .multiplayer-join-input {
    margin-top: 18px;
    margin-bottom: 18px;
}

#MultiplayerPanel .multiplayer-join-input .unity-base-field__label {
    min-width: 146px;
    color: rgb(227, 236, 250);
    font-size: 25px;
}

#MultiplayerPanel .multiplayer-join-input .unity-base-text-field__input {
    min-height: 58px;
    font-size: 25px;
}

#MultiplayerPanel .multiplayer-join-actions {
    width: 100%;
    margin-top: auto;
    flex-direction: row;
    justify-content: space-between;
}

#MultiplayerPanel .multiplayer-create-success-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 42px;
    bottom: 92px;
    justify-content: center;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(0, 0, 0, 0);
}

#MultiplayerPanel .multiplayer-create-success-card {
    width: 100%;
    max-width: 820px;
    min-height: 360px;
    flex-direction: column;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 24px;
    background-color: rgba(72, 92, 142, 0.98);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(0, 0, 0, 0.18);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MultiplayerPanel .multiplayer-create-success-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

#MultiplayerPanel .multiplayer-create-success-instruction {
    margin-top: 12px;
    color: rgb(227, 236, 250);
    font-size: 28px;
}

#MultiplayerPanel .multiplayer-create-success-code {
    margin-top: 18px;
    margin-bottom: 18px;
    min-height: 70px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    color: rgb(246, 249, 255);
    background-color: rgba(38, 54, 96, 0.78);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(13, 22, 42, 0.5);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 31px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

#MultiplayerPanel .multiplayer-create-success-actions {
    width: 100%;
    margin-top: auto;
    flex-direction: row;
    justify-content: space-between;
}

#MultiplayerPanel .multiplayer-action-bar {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-top: auto;
    padding-top: 8px;
    padding-bottom: 12px;
}

#MultiplayerPanel .multiplayer-action-button {
    flex-grow: 1;
    max-width: 220px;
    height: 74px;
    margin-left: 8px;
    margin-right: 8px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

#MultiplayerPanel .multiplayer-action-button .unity-button__text,
#MultiplayerPanel .multiplayer-action-button .unity-text-element {
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

#ProfilePanel {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 8px;
    bottom: 8px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding-left: 0;
    padding-right: 0;
    padding-top: 4px;
    padding-bottom: 4px;
}

#ProfilePanel .profile-card {
    width: 100%;
    max-width: none;
    min-height: 500px;
    flex-direction: column;
    align-self: stretch;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 30px;
    padding-bottom: 26px;
    background-color: rgba(76, 97, 151, 0.96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.34);
    border-right-color: rgba(255, 255, 255, 0.24);
    border-bottom-color: rgba(26, 39, 72, 0.52);
    border-left-color: rgba(255, 255, 255, 0.24);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

#ProfilePanel .profile-title-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

#ProfilePanel .profile-title-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(226, 232, 246, 0.28);
}

#ProfilePanel .profile-title {
    margin-left: 14px;
    margin-right: 14px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(244, 240, 231);
}

#ProfilePanel .profile-username-value {
    margin-top: 4px;
    margin-bottom: 24px;
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(247, 241, 229);
    -unity-text-align: middle-center;
    white-space: normal;
}

#ProfilePanel .profile-field {
    margin-top: 12px;
}

#ProfilePanel .profile-divider {
    width: 100%;
    height: 1px;
    margin-top: 24px;
    margin-bottom: 18px;
    background-color: rgba(226, 232, 246, 0.28);
}

#ProfilePanel .profile-player-id-section {
    margin-bottom: 8px;
}

#ProfilePanel .profile-field-label {
    font-size: 23px;
    color: rgba(236, 240, 250, 0.88);
}

#ProfilePanel .profile-typed-display-name-label {
    width: 100%;
    font-size: 20px;
    -unity-text-align: upper-center;
    white-space: normal;
}

#ProfilePanel .profile-id-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

#ProfilePanel .profile-player-id-value {
    flex-grow: 1;
    min-height: 60px;
    margin-right: 14px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    font-size: 24px;
    -unity-font-style: normal;
    color: rgb(244, 245, 248);
    background-color: rgba(38, 54, 96, 0.78);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(13, 22, 42, 0.5);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-text-align: middle-left;
}

#ProfilePanel .profile-action-button {
    width: 100%;
    height: 78px;
    margin-top: 4px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

#ProfilePanel .profile-action-button .unity-button__text,
#ProfilePanel .profile-action-button .unity-text-element {
    -unity-font-style: bold;
}

#ProfilePanel .profile-action-button-primary {
    color: rgb(53, 40, 18);
    background-color: rgb(237, 201, 132);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 3px;
    border-left-width: 2px;
    border-top-color: rgba(255, 247, 224, 0.75);
    border-right-color: rgba(255, 239, 208, 0.58);
    border-bottom-color: rgba(113, 78, 24, 0.7);
    border-left-color: rgba(255, 239, 208, 0.58);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

#ProfilePanel .profile-action-button-primary .unity-button__text,
#ProfilePanel .profile-action-button-primary .unity-text-element {
    color: rgb(53, 40, 18);
    font-size: 28px;
    -unity-font-style: bold;
}

#ProfilePanel .profile-copy-button {
    width: 42%;
    min-width: 0;
    max-width: 280px;
    height: 60px;
    color: rgb(53, 40, 18);
    background-color: rgb(238, 204, 140);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 3px;
    border-left-width: 2px;
    border-top-color: rgba(255, 247, 224, 0.68);
    border-right-color: rgba(255, 239, 208, 0.5);
    border-bottom-color: rgba(113, 78, 24, 0.66);
    border-left-color: rgba(255, 239, 208, 0.5);
