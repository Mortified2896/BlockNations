.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(52, 74, 118);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.panel {
    width: 96%;
    max-width: 780px;
    max-height: 100%;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
}

#MainPanel {
    max-width: 620px;
    min-height: 68%;
    justify-content: center;
    padding-top: 116px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

#MainPanel .title {
    font-size: 74px;
    margin-bottom: 42px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

#MainPanel .menu-button {
    height: 84px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(15, 17, 21);
    background-color: rgb(247, 248, 250);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(25, 29, 36, 0.2);
    border-right-color: rgba(25, 29, 36, 0.2);
    border-bottom-color: rgba(25, 29, 36, 0.28);
    border-left-color: rgba(25, 29, 36, 0.2);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MainPanel #PlayVsAIButton {
    margin-top: 28px;
    height: 90px;
    background-color: rgb(240, 242, 246);
}

#MultiplayerPanel {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 18px;
    bottom: 18px;
    flex-direction: column;
    justify-content: flex-start;
    padding-left: 0;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

#MultiplayerPanel.multiplayer-pane {
    padding-top: 10px;
    padding-bottom: 6px;
}

#MultiplayerPanel .multiplayer-header-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 26px;
}

#MultiplayerPanel .multiplayer-version-label {
    display: none;
    position: absolute;
    top: 10px;
    right: 0;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.72);
    -unity-text-align: middle-right;
}

#MultiplayerPanel .multiplayer-games-list {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-bottom: 0;
}

#MultiplayerPanel .multiplayer-games-list .unity-scroll-view__content-viewport,
#MultiplayerPanel .multiplayer-games-list .unity-scroll-view__viewport {
    flex-grow: 1;
    min-height: 0;
}

#MultiplayerPanel .multiplayer-games-list .unity-scroll-view__content-container {
    flex-grow: 1;
    min-height: 0;
    padding-bottom: 0;
    align-items: stretch;
    justify-content: flex-start;
}

#MultiplayerPanel .multiplayer-game-card {
    flex-grow: 0;
    min-height: 156px;
    max-height: 168px;
    margin-bottom: 14px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
    align-items: flex-start;
    align-self: stretch;
    justify-content: flex-start;
    background-color: rgb(22, 124, 176);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(0, 0, 0, 0.12);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MultiplayerPanel .multiplayer-game-card.multiplayer-game-card--last {
    margin-bottom: 0;
}

#MultiplayerPanel .multiplayer-games-list.multiplayer-games-list--single .multiplayer-game-card.multiplayer-game-card--single {
    min-height: 172px;
    max-height: 180px;
}

#MultiplayerPanel .multiplayer-game-card-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(243, 250, 255);
    -unity-text-align: middle-left;
}

#MultiplayerPanel .multiplayer-game-card-status {
    margin-top: 8px;
    font-size: 24px;
    color: rgba(243, 250, 255, 0.78);
    -unity-text-align: middle-left;
}

#MultiplayerPanel .multiplayer-empty-state {
    flex-grow: 1;
    align-self: stretch;
    margin-top: 8px;
    color: rgba(232, 240, 252, 0.92);
    font-size: 22px;
    -unity-text-align: upper-left;
}

#MultiplayerPanel .multiplayer-details-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 42px;
    bottom: 92px;
    justify-content: center;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(0, 0, 0, 0);
}

#MultiplayerPanel .multiplayer-details-card {
    width: 100%;
    max-width: 820px;
    min-height: 440px;
    flex-direction: column;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 24px;
    background-color: rgba(72, 92, 142, 0.98);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(0, 0, 0, 0.18);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#MultiplayerPanel .multiplayer-details-header {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

#MultiplayerPanel .multiplayer-details-title {
    flex-grow: 1;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

#MultiplayerPanel .multiplayer-details-subtitle {
    margin-top: 10px;
    margin-bottom: 22px;
    color: rgb(227, 236, 250);
    font-size: 30px;
    white-space: normal;
}

#MultiplayerPanel .multiplayer-details-actions {
    flex-direction: row;
    justify-content: space-between;
}

#MultiplayerPanel .multiplayer-details-actions-bottom {
    width: 100%;
    margin-top: auto;
}

#MultiplayerPanel .multiplayer-details-button {
    flex-grow: 1;
    max-width: none;
    height: 74px;
    margin-left: 8px;
    margin-right: 8px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

#MultiplayerPanel .multiplayer-details-button .unity-button__text,
#MultiplayerPanel .multiplayer-details-button .unity-text-element {
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

#MultiplayerPanel .multiplayer-details-button-danger {
    color: rgb(230, 52, 52);
}

#MultiplayerPanel .multiplayer-details-button-danger .unity-button__text,
#MultiplayerPanel .multiplayer-details-button-danger .unity-text-element {
    color: rgb(230, 52, 52);
    -unity-font-style: bold;
}

#MultiplayerPanel .multiplayer-details-button-danger-corner {
    flex-grow: 0;
    width: 188px;
    min-width: 188px;
    margin-top: 0;
    margin-right: 0;
}

#MultiplayerPanel .multiplayer-status {
    width: 100%;
    min-height: 34px;
    color: rgb(232, 240, 252);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#MultiplayerPanel .multiplayer-action-bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 8px;
    padding-bottom: 12px;
}

#MultiplayerPanel .multiplayer-action-button {
    flex-grow: 1;
    max-width: none;
    height: 74px;
    margin-left: 8px;
    margin-right: 8px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

#MultiplayerPanel .multiplayer-action-button .unity-button__text,
#MultiplayerPanel .multiplayer-action-button .unity-text-element {
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

.title {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.menu-button {
    height: 72px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 26px;
    color: rgb(45, 49, 57);
    background-color: rgb(237, 238, 241);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.small {
    flex-grow: 1;
    max-width: 240px;
    margin-left: 5px;
    margin-right: 5px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
    margin-bottom: 8px;
}

.details-panel {
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(230, 239, 255, 0.45);
}

.details-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(238, 242, 250);
}

.details-subtitle {
    margin-top: 4px;
    margin-bottom: 8px;
    color: rgb(227, 236, 250);
}

.danger {
    color: rgb(255, 167, 167);
}

.status {
    margin-top: 8px;
    margin-bottom: 8px;
    min-height: 20px;
    color: rgb(232, 240, 252);
    font-size: 14px;
}

.version-label {
    position: absolute;
    top: 16px;
    right: 16px;

    font-size: 35px;
    color: rgba(255, 255, 255, 0.7);

    -unity-text-align: upper-right;
}

.non-mvp-hidden {
    display: none;
}
