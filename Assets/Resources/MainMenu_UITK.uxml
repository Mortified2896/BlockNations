<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="MainMenuRoot" class="root">
        <ui:VisualElement name="MainPanel" class="panel">
            <ui:Label name="TitleLabel" text="Block Nations" class="title" />
            <ui:Button name="PlayVsAIButton" text="Play vs AI" class="menu-button" />
            <ui:Button name="ContinueButton" text="Continue" class="menu-button" />
            <ui:Button name="PlayHotseatButton" text="Play Hotseat" class="menu-button non-mvp-hidden" />
            <ui:Button name="MultiplayerButton" text="Multiplayer" class="menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="MultiplayerPanel" class="multiplayer-pane">
            <ui:VisualElement class="multiplayer-header-row">
                <ui:Label name="StatusLabel" text="" class="multiplayer-status" />
                <ui:Label name="MultiplayerVersionLabel" text="" class="multiplayer-version-label" />
            </ui:VisualElement>
            <ui:ScrollView name="ActiveGamesList" class="multiplayer-games-list" />

            <ui:VisualElement name="DetailsPanel" class="multiplayer-details-overlay">
                <ui:VisualElement class="multiplayer-details-card">
                    <ui:VisualElement class="multiplayer-details-header">
                        <ui:Label name="DetailsTitleLabel" text="Game Details" class="multiplayer-details-title" />
                        <ui:Button name="DetailsResignButton" text="Resign" class="menu-button multiplayer-details-button multiplayer-details-button-danger multiplayer-details-button-danger-corner" />
                    </ui:VisualElement>
                    <ui:Label name="DetailsSubtitleLabel" text="" class="multiplayer-details-subtitle" />
                    <ui:VisualElement class="multiplayer-details-actions multiplayer-details-actions-bottom">
                        <ui:Button name="DetailsOpenButton" text="Open" class="menu-button multiplayer-details-button" />
                        <ui:Button name="DetailsCloseButton" text="Close" class="menu-button multiplayer-details-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="multiplayer-action-bar">
                <ui:Button name="CreateButton" text="Create" class="menu-button multiplayer-action-button" />
                <ui:Button name="JoinButton" text="Join" class="menu-button multiplayer-action-button" />
                <ui:Button name="MultiplayerBackButton" text="Back" class="menu-button multiplayer-action-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="VersionLabel" text="" class="version-label" />
    </ui:VisualElement>
</ui:UXML>
