<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/MainMenu_UITK.uss?fileID=7433441132597879392&amp;guid=1f9fc51f9f9a74a6f9abfc538ceeb4da&amp;type=3#MainMenu_UITK" />
    <ui:VisualElement name="MainMenuRoot" class="root">
        <ui:VisualElement name="MainPanel" class="panel">
            <ui:Label name="TitleLabel" text="Block Nations" class="title" />
            <ui:Button name="PlayVsAIButton" text="Play vs AI" class="menu-button" />
            <ui:Button name="ContinueButton" text="Continue" class="menu-button" />
            <ui:Button name="MultiplayerButton" text="Multiplayer" class="menu-button">
                <ui:VisualElement name="MultiplayerBadge" class="multiplayer-button-badge" style="display: none;" />
            </ui:Button>
            <ui:Button name="ProfileButton" text="Profile" class="menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="MultiplayerPanel" class="multiplayer-pane" style="display: none;">
            <ui:VisualElement class="multiplayer-header-row">
                <ui:Label name="StatusLabel" text="" class="multiplayer-status" style="display: none;" />
                <ui:Label name="MultiplayerRefreshCountdownLabel" text="" class="multiplayer-refresh-countdown" style="display: none;" />
                <ui:Label name="MultiplayerVersionLabel" text="" class="multiplayer-version-label" />
            </ui:VisualElement>
            <ui:ScrollView name="ActiveGamesList" class="multiplayer-games-list" />

            <ui:VisualElement name="DetailsPanel" class="multiplayer-details-overlay" style="display: none;">
                <ui:VisualElement class="multiplayer-details-card">
                    <ui:VisualElement class="multiplayer-details-header">
                        <ui:Label name="DetailsTitleLabel" text="Game Details" class="multiplayer-details-title" />
                        <ui:Button name="DetailsResignButton" text="Resign" class="menu-button multiplayer-details-button multiplayer-details-button-danger multiplayer-details-button-danger-corner" />
                    </ui:VisualElement>
                    <ui:Label name="DetailsSubtitleLabel" text="" class="multiplayer-details-subtitle" />
                    <ui:Label name="DetailsGameIdLabel" text="" class="multiplayer-details-gameid" style="display: none;" />
                    <ui:VisualElement class="multiplayer-details-actions multiplayer-details-actions-secondary">
                        <ui:Button name="DetailsSendReminderButton" text="Send Reminder" class="menu-button multiplayer-details-button multiplayer-details-button-secondary" style="display: none;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="multiplayer-details-actions multiplayer-details-actions-bottom">
                        <ui:Button name="DetailsOpenButton" text="Open" class="menu-button multiplayer-details-button" />
                        <ui:Button name="DetailsCloseButton" text="Close" class="menu-button multiplayer-details-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="JoinPanel" class="multiplayer-join-overlay" style="display: none;">
                <ui:VisualElement class="multiplayer-join-card">
                    <ui:Label text="Join Game" class="multiplayer-join-title" />
                    <ui:TextField name="JoinGameIdInput" label="Game ID" class="multiplayer-join-input" />
                    <ui:VisualElement class="multiplayer-join-actions">
                        <ui:Button name="JoinConfirmButton" text="Join" class="menu-button multiplayer-details-button" />
                        <ui:Button name="JoinCancelButton" text="Cancel" class="menu-button multiplayer-details-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="CreateSuccessPanel" class="multiplayer-create-success-overlay" style="display: none;">
                <ui:VisualElement class="multiplayer-create-success-card">
                    <ui:Label text="Game Created" class="multiplayer-create-success-title" />
                    <ui:Label text="Send this code to your friend" class="multiplayer-create-success-instruction" />
                    <ui:Label name="CreateSuccessGameCodeLabel" text="" class="multiplayer-create-success-code" />
                    <ui:VisualElement class="multiplayer-create-success-actions">
                        <ui:Button name="CreateSuccessCopyButton" text="Copy Code" class="menu-button multiplayer-details-button" />
                        <ui:Button name="CreateSuccessCloseButton" text="Close" class="menu-button multiplayer-details-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="multiplayer-action-bar">
                <ui:Button name="CreateButton" text="Create" class="menu-button multiplayer-action-button" />
                <ui:Button name="JoinButton" text="Join" class="menu-button multiplayer-action-button" />
                <ui:Button name="MultiplayerBackButton" text="Back" class="menu-button multiplayer-action-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ProfilePanel" class="profile-pane" style="display: none;">
            <ui:VisualElement class="profile-card">
                <ui:VisualElement class="profile-title-row">
                    <ui:VisualElement class="profile-title-line" />
                    <ui:Label text="Profile" class="profile-title" />
                    <ui:VisualElement class="profile-title-line" />
                </ui:VisualElement>

                <ui:Label name="ProfileUsernameValueLabel" text="" class="profile-username-value" />
                <ui:Button name="ProfileRegenerateButton" text="Regenerate Name" class="menu-button profile-action-button profile-action-button-primary" />

                <ui:VisualElement class="profile-divider" />

                <ui:VisualElement class="profile-field">
                    <ui:Label text="Please set a recognizable name for playtesting (2–12 chars)" class="profile-field-label profile-typed-display-name-label" />
                    <ui:TextField name="ProfileTypedDisplayNameInput" value="" />
                </ui:VisualElement>

                <ui:VisualElement class="profile-field profile-player-id-section">
                    <ui:Label text="Player ID" class="profile-field-label" />
                    <ui:VisualElement class="profile-id-row">
                        <ui:Label name="ProfilePlayerIdValueLabel" text="" class="profile-player-id-value" />
                        <ui:Button name="ProfileCopyPlayerIdButton" text="Copy Player ID" class="menu-button profile-copy-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="ProfileStatusLabel" text="" class="profile-status-label" style="display: none;" />
                <ui:Button name="ProfileBackButton" text="Back" class="menu-button profile-back-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="VersionLabel" text="" class="version-label" />
    </ui:VisualElement>
</ui:UXML>
