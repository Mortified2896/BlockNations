<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/MainMenu_UITK.uss?fileID=7433441132597879392&amp;guid=1f9fc51f9f9a74a6f9abfc538ceeb4da&amp;type=3#MainMenu_UITK" />
    <ui:VisualElement name="MainMenuRoot" class="root">
        <ui:VisualElement name="MainPanel" class="panel">
            <ui:Label name="TitleLabel" text="Block Nations" class="title" />
            <ui:Button name="PlayVsAIButton" text="Play vs AI" class="menu-button" />
            <ui:Button name="ContinueButton" text="Continue" class="menu-button" />
            <ui:Button name="MultiplayerButton" text="Multiplayer" class="menu-button">
                <ui:VisualElement name="MultiplayerBadge" class="multiplayer-button-badge" style="display: none;" />
            </ui:Button>
            <ui:Button name="ProfileButton" text="Profile" class="menu-button" />
        </ui:VisualElement>

        <ui:VisualElement name="MultiplayerPanel" class="multiplayer-pane" style="display: none;">
            <ui:VisualElement class="multiplayer-header-row">
                <ui:Label name="StatusLabel" text="" class="multiplayer-status" style="display: none;" />
                <ui:Label name="MultiplayerRefreshCountdownLabel" text="" class="multiplayer-refresh-countdown" style="display: none;" />
                <ui:Label name="MultiplayerVersionLabel" text="" class="multiplayer-version-label" />
            </ui:VisualElement>
            <ui:ScrollView name="ActiveGamesList" class="multiplayer-games-list" />

            <ui:VisualElement name="DetailsPanel" class="multiplayer-details-overlay" style="display: none;">
                <ui:VisualElement class="multiplayer-details-card">
                    <ui:VisualElement name="DetailsContent" class="multiplayer-details-content">
                        <ui:VisualElement class="multiplayer-details-header">
                            <ui:Label name="DetailsTitleLabel" text="Game Details" class="multiplayer-details-title" />
                            <ui:Button name="DetailsResignButton" text="Resign" class="menu-button multiplayer-details-button multiplayer-details-button-danger multiplayer-details-button-danger-corner" />
                        </ui:VisualElement>
                        <ui:Label name="DetailsSubtitleLabel" text="" class="multiplayer-details-subtitle" />
                        <ui:Label name="DetailsGameIdLabel" text="" class="multiplayer-details-gameid" style="display: none;" />
                        <ui:VisualElement class="multiplayer-details-actions multiplayer-details-actions-secondary">
                            <ui:Button name="DetailsSendReminderButton" text="Send Reminder" class="menu-button multiplayer-details-button multiplayer-details-button-secondary" style="display: none;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="multiplayer-details-actions multiplayer-details-actions-bottom">
                            <ui:Button name="DetailsOpenButton" text="Open" class="menu-button multiplayer-details-button" />
                            <ui:Button name="DetailsCloseButton" text="Close" class="menu-button multiplayer-details-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="DetailsResignConfirmContent" class="multiplayer-details-confirm-content" style="display: none;">
                        <ui:Label text="Confirm Resign" class="multiplayer-confirm-title" />
                        <ui:VisualElement class="multiplayer-confirm-body-region">
                            <ui:Label text="Are you sure you want to resign from this game?" class="multiplayer-confirm-body" />
                        </ui:VisualElement>
                        <ui:VisualElement class="multiplayer-confirm-actions">
                            <ui:Button name="ResignConfirmCancelButton" text="Cancel" class="menu-button multiplayer-details-button" />
                            <ui:Button name="ResignConfirmAcceptButton" text="Resign" class="menu-button multiplayer-details-button multiplayer-details-button-danger" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="JoinPanel" class="multiplayer-join-overlay" style="display: none;">
                <ui:VisualElement class="multiplayer-join-card">
                    <ui:Label text="Join Game" class="multiplayer-join-title" />
                    <ui:TextField name="JoinGameIdInput" label="Game ID" class="multiplayer-join-input" />
                    <ui:VisualElement class="multiplayer-join-actions">
                        <ui:Button name="JoinConfirmButton" text="Join" class="menu-button multiplayer-details-button" />
                        <ui:Button name="JoinCancelButton" text="Cancel" class="menu-button multiplayer-details-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="CreateSuccessPanel" class="multiplayer-create-success-overlay" style="display: none;">
                <ui:VisualElement class="multiplayer-create-success-card">
                    <ui:Label text="Game Created" class="multiplayer-create-success-title" />
                    <ui:Label text="Send this code to your friend" class="multiplayer-create-success-instruction" />
                    <ui:Label name="CreateSuccessGameCodeLabel" text="" class="multiplayer-create-success-code" />
                    <ui:VisualElement class="multiplayer-create-success-actions">
                        <ui:Button name="CreateSuccessCopyButton" text="Copy Code" class="menu-button multiplayer-details-button" />
                        <ui:Button name="CreateSuccessCloseButton" text="Close" class="menu-button multiplayer-details-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="multiplayer-action-bar">
                <ui:Button name="CreateButton" text="Create" class="menu-button multiplayer-action-button" />
                <ui:Button name="JoinButton" text="Join" class="menu-button multiplayer-action-button" />
                <ui:Button name="MultiplayerBackButton" text="Back" class="menu-button multiplayer-action-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ProfilePanel" class="profile-pane" style="display: none;">
            <ui:VisualElement class="profile-card">
                <ui:VisualElement class="profile-title-row">
                    <ui:VisualElement class="profile-title-line" />
                    <ui:Label text="Profile" class="profile-title ui-text-title" />
                    <ui:VisualElement class="profile-title-line" />
                </ui:VisualElement>

                <ui:Label name="ProfileUsernameValueLabel" text="" class="profile-username-value" style="display: none;" />
                <ui:Button name="ProfileRegenerateButton" text="Regenerate Name" class="menu-button profile-action-button profile-action-button-primary ui-text-button" style="display: none;" />

                <ui:VisualElement class="profile-divider" />

                <ui:VisualElement class="profile-field">
                    <ui:Label text="Please set a recognizable name for playtesting (2–12 chars)" class="profile-field-label profile-typed-display-name-label ui-text-body" />
                    <ui:TextField name="ProfileTypedDisplayNameInput" value="" class="profile-typed-display-name-input ui-text-body" />
                </ui:VisualElement>

                <ui:VisualElement class="profile-field profile-player-id-section">
                    <ui:Label text="Player ID" class="profile-field-label ui-text-meta" />
                    <ui:VisualElement class="profile-id-row">
                        <ui:Label name="ProfilePlayerIdValueLabel" text="" class="profile-player-id-value ui-text-body" />
                        <ui:Button name="ProfileCopyPlayerIdButton" text="Copy Player ID" class="menu-button profile-copy-button ui-text-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="ProfileStatusLabel" text="" class="profile-status-label ui-text-meta" style="display: none;" />
                <ui:Button name="ProfileBackButton" text="Back" class="menu-button profile-back-button ui-text-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="GeneralSettingsPanel" class="general-settings-overlay" style="display: none;">
            <ui:ScrollView name="GeneralSettingsScrollView" class="general-settings-scroll" mode="Vertical">
                <ui:VisualElement name="GeneralSettingsCard" class="general-settings-card">
                    <ui:Label name="GeneralSettingsTitleLabel" text="General Settings" class="general-settings-title" />
                    <ui:Label name="GeneralSettingsSubtitleLabel" text="" class="general-settings-subtitle" />

                    <ui:VisualElement class="general-settings-section">
                        <ui:Label text="Map Size" class="general-settings-section-label" />
                        <ui:VisualElement class="general-settings-option-row">
                            <ui:Button name="GeneralSettingsMapSmallButton" text="Small 10x10" class="menu-button general-settings-option-button" />
                            <ui:Button name="GeneralSettingsMapLargeButton" text="Large 15x15" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="GeneralSettingsAiSection" class="general-settings-section">
                        <ui:Label text="AI Level" class="general-settings-section-label" />
                        <ui:VisualElement class="general-settings-option-grid">
                            <ui:VisualElement class="general-settings-option-row general-settings-option-row--grid">
                                <ui:Button name="GeneralSettingsAiLevel1Button" text="Easy" class="menu-button general-settings-option-button" />
                                <ui:Button name="GeneralSettingsAiLevel2Button" text="Standard" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                            </ui:VisualElement>
                            <ui:VisualElement class="general-settings-option-row general-settings-option-row--grid">
                                <ui:Button name="GeneralSettingsAiLevel3Button" text="Hard" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="AI Style" class="general-settings-section-label" />
                        <ui:VisualElement class="general-settings-option-row">
                            <ui:Button name="GeneralSettingsAiStyleDefaultButton" text="Default" class="menu-button general-settings-option-button" />
                            <ui:Button name="GeneralSettingsAiStyleRiderFocusButton" text="Rider Focus" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="GeneralSettingsDevSection" class="general-settings-section" style="display: none;">
                        <ui:Label text="Dev Options" class="general-settings-section-label" />
                        <ui:Toggle name="GeneralSettingsStoreSnapshotHistoryToggle" label="Store Snapshot History" class="general-settings-dev-toggle" />
                        <ui:Toggle name="GeneralSettingsWatchAIVsAIToggle" label="Watch AI vs AI" class="general-settings-dev-toggle" />
                        <ui:VisualElement name="GeneralSettingsAIVsAIOptionsSection" style="display: none;">
                            <ui:Label text="Side A AI Style" class="general-settings-section-label" />
                            <ui:VisualElement class="general-settings-option-row">
                                <ui:Button name="GeneralSettingsSideAAiStyleDefaultButton" text="Default" class="menu-button general-settings-option-button" />
                                <ui:Button name="GeneralSettingsSideAAiStyleRiderFocusButton" text="Rider Focus" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                            </ui:VisualElement>
                            <ui:Label text="Side A AI Profile" class="general-settings-section-label" />
                            <ui:VisualElement class="general-settings-option-row">
                                <ui:Button name="GeneralSettingsSideAAiProfileBaselineButton" text="Baseline" class="menu-button general-settings-option-button" />
                                <ui:Button name="GeneralSettingsSideAAiProfileCalculusButton" text="Calculus AI" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                            </ui:VisualElement>
                            <ui:Label text="Side B AI Style" class="general-settings-section-label" />
                            <ui:VisualElement class="general-settings-option-row">
                                <ui:Button name="GeneralSettingsSideBAiStyleDefaultButton" text="Default" class="menu-button general-settings-option-button" />
                                <ui:Button name="GeneralSettingsSideBAiStyleRiderFocusButton" text="Rider Focus" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                            </ui:VisualElement>
                            <ui:Label text="Side B AI Profile" class="general-settings-section-label" />
                            <ui:VisualElement class="general-settings-option-row">
                                <ui:Button name="GeneralSettingsSideBAiProfileBaselineButton" text="Baseline" class="menu-button general-settings-option-button" />
                                <ui:Button name="GeneralSettingsSideBAiProfileCalculusButton" text="Calculus AI" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                            </ui:VisualElement>
                            <ui:Label text="Simulation Presets" class="general-settings-section-label" />
                            <ui:VisualElement class="general-settings-option-grid">
                                <ui:VisualElement class="general-settings-option-row general-settings-option-row--grid">
                                    <ui:Button name="GeneralSettingsAIVsAiPresetQuickButton" text="Quick" class="menu-button general-settings-option-button" />
                                    <ui:Button name="GeneralSettingsAIVsAiPresetStandardButton" text="Standard" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                                </ui:VisualElement>
                                <ui:VisualElement class="general-settings-option-row general-settings-option-row--grid">
                                    <ui:Button name="GeneralSettingsAIVsAiPresetStrictButton" text="Strict" class="menu-button general-settings-option-button" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label text="Presets fill recommended defaults. You can edit every value after choosing one." class="general-settings-help-text" />
                            <ui:Label text="Evaluation Method" class="general-settings-section-label" />
                            <ui:VisualElement class="general-settings-option-row">
                                <ui:Button name="GeneralSettingsAIVsAiEvaluationMethodBayesianButton" text="Bayesian" class="menu-button general-settings-option-button" />
                            </ui:VisualElement>
                            <ui:Label text="Bayesian certainty uses decisive wins and losses only. Draws and aborts are reported separately." class="general-settings-help-text" />
                            <ui:TextField name="GeneralSettingsAIVsAiCertaintyThresholdInput" label="Certainty Threshold" class="general-settings-input-field" />
                            <ui:Label text="Stop when the system is this sure one AI is better." class="general-settings-help-text" />
                            <ui:TextField name="GeneralSettingsAIVsAiMinimumGamesInput" label="Minimum Games" class="general-settings-input-field" />
                            <ui:Label text="Prevents early stops from tiny samples." class="general-settings-help-text" />
                            <ui:TextField name="GeneralSettingsAIVsAiTimeBudgetMinutesInput" label="Time Budget (Minutes)" class="general-settings-input-field" />
                            <ui:Label text="Normal stop when this wall-clock budget is reached." class="general-settings-help-text" />
                            <ui:TextField name="GeneralSettingsAIVsAiBatchSizeInput" label="Batch Size" class="general-settings-input-field" />
                            <ui:Label text="Games to run between certainty checks." class="general-settings-help-text" />
                            <ui:VisualElement class="general-settings-subcard general-settings-subcard--danger">
                                <ui:Label text="Emergency Failsafe" class="general-settings-subcard-title" />
                                <ui:TextField name="GeneralSettingsAIVsAiEmergencyHardMaxGamesInput" label="Emergency Hard Max Games" class="general-settings-input-field" />
                                <ui:Label text="Failsafe only. If this fuse trips, the run is abnormal and may be unreliable." class="general-settings-help-text general-settings-help-text--warning" />
                            </ui:VisualElement>
                            <ui:Label text="Batch Speed" class="general-settings-section-label" />
                            <ui:VisualElement class="general-settings-option-grid">
                                <ui:VisualElement class="general-settings-option-row general-settings-option-row--grid">
                                    <ui:Button name="GeneralSettingsAIVsAiBatchSpeedNormalButton" text="Normal" class="menu-button general-settings-option-button" />
                                    <ui:Button name="GeneralSettingsAIVsAiBatchSpeedFastButton" text="Fast" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                                </ui:VisualElement>
                                <ui:VisualElement class="general-settings-option-row general-settings-option-row--grid">
                                    <ui:Button name="GeneralSettingsAIVsAiBatchSpeedVeryFastButton" text="Very Fast" class="menu-button general-settings-option-button" />
                                    <ui:Button name="GeneralSettingsAIVsAiBatchSpeedUltraFastButton" text="Ultra Fast" class="menu-button general-settings-option-button general-settings-option-button--row-end" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="general-settings-actions">
                        <ui:Button name="GeneralSettingsConfirmButton" text="Start Game" class="menu-button general-settings-action-button general-settings-action-button--first general-settings-action-button-primary" />
                        <ui:Button name="GeneralSettingsBackButton" text="Back" class="menu-button general-settings-action-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:Label name="VersionLabel" text="" class="version-label" />
    </ui:VisualElement>
</ui:UXML>
