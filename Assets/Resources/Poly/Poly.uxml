<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Poly.uss" />
    <ui:VisualElement name="PolyHudRoot" class="poly-hud" picking-mode="Ignore">
        <ui:VisualElement name="Bottom" class="poly-bottom" picking-mode="Ignore">
            <ui:VisualElement name="Sheet" class="poly-sheet" style="display: none;">
                <ui:VisualElement class="sheet-heading">
                    <ui:Label name="SheetTitle" class="sheet-title" picking-mode="Ignore" />
                    <ui:Button name="CloseSheet" text="×" class="close-button" />
                </ui:VisualElement>
                <ui:Label name="Summary" class="summary" picking-mode="Ignore" />
                <ui:VisualElement name="Growth" class="growth" picking-mode="Ignore" style="display: none;">
                    <ui:Label name="GrowthLabel" class="growth-label" picking-mode="Ignore" />
                    <ui:VisualElement class="growth-track" picking-mode="Ignore">
                        <ui:VisualElement name="GrowthFill" class="growth-fill" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SheetTabs" class="button-row" />
                <ui:VisualElement name="Choices" class="choices" />
                <ui:VisualElement name="Pages" class="pages">
                    <ui:Button name="Previous" text="‹" class="page-button" />
                    <ui:Label name="PageLabel" picking-mode="Ignore" />
                    <ui:Button name="Following" text="›" class="page-button" />
                </ui:VisualElement>
                <ui:Label name="Hint" class="hint" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Toolbar" class="toolbar">
                <ui:Button name="Menu" text="Menu" class="toolbar-button" />
                <ui:Button name="Tech" text="Tech" class="toolbar-button" />
                <ui:Button name="EndTurn" text="End turn" class="toolbar-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Overlay" class="overlay" style="display: none;">
            <ui:VisualElement name="OverlayCard" class="overlay-card">
                <ui:VisualElement class="sheet-heading">
                    <ui:Label name="OverlayTitle" class="sheet-title" picking-mode="Ignore" />
                    <ui:Button name="CloseOverlay" text="×" class="close-button" />
                </ui:VisualElement>
                <ui:Label name="OverlaySummary" class="summary" picking-mode="Ignore" />
                <ui:VisualElement name="OverlayTabs" class="button-row" />
                <ui:VisualElement name="OverlayChoices" class="overlay-choices" />
                <ui:VisualElement name="OverlayPages" class="pages" />
                <ui:Label name="OverlayHint" class="hint" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
