.poly-root { flex-grow: 1; background-color: rgb(24, 39, 51); color: rgb(245, 239, 220); padding: 12px; }
.poly-header { flex-direction: row; align-items: center; flex-wrap: wrap; flex-shrink: 0; }
.poly-title { font-size: 27px; -unity-font-style: bold; margin-right: 12px; }
.poly-subtitle { flex-grow: 1; font-size: 13px; color: rgb(177, 196, 194); }
.resources { font-size: 17px; -unity-font-style: bold; margin-top: 6px; margin-bottom: 6px; white-space: normal; flex-shrink: 0; }
.poly-toolbar, .poly-footer { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.poly-button { min-height: 42px; margin: 3px; padding: 8px; background-color: rgb(52, 73, 81); color: rgb(248, 242, 221); border-radius: 5px; border-width: 1px; border-color: rgb(92, 112, 116); white-space: normal; }
.poly-button:hover { background-color: rgb(70, 97, 102); }
.poly-button:disabled { opacity: 0.5; }
.zoom { min-width: 42px; }
.primary { flex-grow: 1; background-color: rgb(212, 177, 99); color: rgb(27, 41, 49); -unity-font-style: bold; }
.poly-body { flex-grow: 1; min-height: 80px; flex-direction: row; }
.board-scroll { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 80px; background-color: rgb(15, 26, 34); }
.poly-board { flex-shrink: 0; align-self: center; }
.poly-tile { margin: 0; padding: 0; flex-shrink: 0; border-radius: 0; border-width: 1px; border-color: rgb(37, 51, 41); }
.poly-tile.friendly-territory { border-color: rgb(91, 167, 216); }
.poly-tile.selected { border-width: 3px; border-color: rgb(255, 223, 117); }
.poly-tile.reachable { border-width: 2px; border-color: rgb(177, 236, 114); }
.poly-tile.target { border-width: 2px; border-color: rgb(255, 105, 86); }
.tile-label { position: absolute; bottom: 1px; left: 0; right: 0; font-size: 10px; color: white; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0.45); }
.poly-details { width: 340px; min-height: 85px; flex-shrink: 0; background-color: rgb(30, 47, 57); padding: 10px; }
.poly-details Label { white-space: normal; margin: 4px; font-size: 14px; }
.poly-details .sheet-title { font-size: 20px; -unity-font-style: bold; margin-top: 8px; }
.poly-details .tech-description { color: rgb(188, 206, 196); font-size: 12px; margin-bottom: 10px; }
.poly-status { white-space: normal; font-size: 12px; margin-top: 7px; max-height: 42px; overflow: hidden; flex-shrink: 0; }
.saved { color: rgb(175, 196, 180); font-size: 11px; margin: 3px; min-height: 15px; flex-shrink: 0; }
.poly-root .unity-scroller { background-color: rgb(25, 42, 51); }
.poly-root .unity-scroller--vertical { width: 12px; }
.poly-root .unity-scroller--horizontal { height: 12px; }
.poly-root .unity-scroller__low-button, .poly-root .unity-scroller__high-button { display: none; }
.poly-root .unity-base-slider__tracker { background-color: rgb(25, 42, 51); }
.poly-root .unity-base-slider__dragger { background-color: rgb(91, 113, 119); border-width: 0; }
