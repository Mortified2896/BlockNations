<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/GameplayTopHud_UITK.uss?fileID=7433441132597879392&amp;guid=c2bd795e91ad4aa9aeeb6c8650731428&amp;type=3#GameplayTopHud_UITK" />
    <ui:Template name="FeedbackForm" src="Feedback_UITK.uxml" />
    <Style src="Feedback_UITK.uss" />
    <ui:VisualElement name="GameplayTopHudRoot" class="gameplay-top-hud-root">
        <ui:VisualElement name="TopBar" class="gameplay-top-hud-bar">
            <ui:Label name="TurnLabel" text="Turn 1 - Player" class="gameplay-top-hud-label gameplay-top-hud-turn" />
            <ui:Label name="GoldLabel" text="Gold 0" class="gameplay-top-hud-label gameplay-top-hud-gold" />
            <ui:Label name="PbpStatusLabel" text="" class="gameplay-top-hud-label gameplay-top-hud-status" />
        </ui:VisualElement>
        <ui:VisualElement name="TournamentStandingsPanel" class="gameplay-tournament-standings-panel">
            <ui:Label name="TournamentStandingsTitle" text="Standings" class="gameplay-tournament-standings-title" />
            <ui:VisualElement class="gameplay-tournament-standings-header">
                <ui:Label name="TournamentStandingsRankHeader" text="#" class="gameplay-tournament-standings-cell gameplay-tournament-standings-cell-rank gameplay-tournament-standings-cell-header" />
                <ui:Label text="Variant" class="gameplay-tournament-standings-cell gameplay-tournament-standings-cell-variant gameplay-tournament-standings-cell-header" />
                <ui:Label text="G" class="gameplay-tournament-standings-cell gameplay-tournament-standings-cell-games gameplay-tournament-standings-cell-header" />
                <ui:Label text="W" class="gameplay-tournament-standings-cell gameplay-tournament-standings-cell-small gameplay-tournament-standings-cell-header" />
                <ui:Label text="L" class="gameplay-tournament-standings-cell gameplay-tournament-standings-cell-small gameplay-tournament-standings-cell-header" />
                <ui:Label text="D" class="gameplay-tournament-standings-cell gameplay-tournament-standings-cell-small gameplay-tournament-standings-cell-header" />
                <ui:Label name="TournamentStandingsScoreHeader" text="Score %" class="gameplay-tournament-standings-cell gameplay-tournament-standings-cell-score gameplay-tournament-standings-cell-header" />
            </ui:VisualElement>
            <ui:VisualElement name="TournamentStandingsRows" class="gameplay-tournament-standings-rows" />
        </ui:VisualElement>
        <ui:Button name="FeedbackButton" text="Feedback" class="feedback-button" />
        <ui:Instance template="FeedbackForm" name="FeedbackForm" class="feedback-template" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
