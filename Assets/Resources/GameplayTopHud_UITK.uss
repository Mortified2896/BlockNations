.gameplay-top-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: stretch;
    justify-content: flex-start;
}

.gameplay-top-hud-bar {
    width: 100%;
    min-height: 170px;
    padding-top: 14px;
    padding-right: 0;
    padding-bottom: 12px;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0.51);
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    row-gap: 12px;
}

.gameplay-top-hud-label {
    width: 260px;
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.gameplay-top-hud-turn {
    width: 320px;
}

.gameplay-top-hud-gold {
    width: 190px;
}

.gameplay-top-hud-status {
    width: 460px;
    font-size: 28px;
}

.gameplay-tournament-standings-panel {
    position: absolute;
    top: 212px;
    right: 16px;
    width: 680px;
    max-height: 70%;
    padding: 18px 22px 20px 22px;
    background-color: rgba(0, 0, 0, 0.78);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    display: none;
    flex-direction: column;
    row-gap: 10px;
}

.gameplay-tournament-standings-title {
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.gameplay-tournament-standings-header,
.gameplay-tournament-standings-row {
    flex-direction: row;
    column-gap: 10px;
}

.gameplay-tournament-standings-header {
    align-items: center;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.18);
}

.gameplay-tournament-standings-rows {
    flex-direction: column;
    row-gap: 6px;
}

.gameplay-tournament-standings-row {
    align-items: flex-start;
    min-height: 38px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.gameplay-tournament-standings-cell {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-text-align: middle-left;
}

.gameplay-tournament-standings-cell-header {
    color: rgba(255, 255, 255, 0.82);
    font-size: 20px;
    -unity-font-style: bold;
}

.gameplay-tournament-standings-cell-rank {
    width: 28px;
    min-width: 28px;
}

.gameplay-tournament-standings-cell-variant {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    white-space: normal;
}

.gameplay-tournament-standings-cell-games {
    width: 34px;
    min-width: 34px;
    -unity-text-align: middle-right;
}

.gameplay-tournament-standings-cell-small {
    width: 32px;
    min-width: 32px;
    -unity-text-align: middle-right;
}

.gameplay-tournament-standings-cell-score {
    width: 96px;
    min-width: 96px;
    -unity-text-align: middle-right;
}
