.gameplay-top-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: stretch;
    justify-content: flex-start;
}

.gameplay-top-hud-bar {
    width: 100%;
    min-height: 250px;
    padding-top: 36px;
    padding-right: 0;
    padding-bottom: 30px;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0.51);
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    row-gap: 30px;
}

.gameplay-top-hud-label {
    width: 300px;
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.gameplay-top-hud-turn {
    width: 360px;
}

.gameplay-top-hud-gold {
    width: 220px;
}

.gameplay-top-hud-status {
    width: 540px;
    font-size: 42px;
}
