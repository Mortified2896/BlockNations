<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Diagnostic Condition="'$(Diagnostic)' == ''">true</Diagnostic>
    <DefineConstants Condition="'$(Diagnostic)' == 'true'">$(DefineConstants);BLOCKNATIONS_TRAINING_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Simulation/*.cs" />
    <Compile Include="../../Assets/Scripts/AI/Policy/*.cs" />
    <Compile Include="../../Assets/Scripts/Training/Core/*.cs" />
    <Compile Include="Checks.cs" />
  </ItemGroup>
</Project>
